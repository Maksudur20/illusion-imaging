# ----------------------------------------------------------------------
# Illusion Imaging - Clean URLs & Security Configuration
# ----------------------------------------------------------------------

RewriteEngine On
RewriteBase /

# 1. Redirect /index.html to / (Root)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*index\.html\ HTTP/ [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# 2. Redirect /filename.html to /filename (Clean URL)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP/ [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Internally rewrite /filename to /filename.html if file exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# ----------------------------------------------------------------------
# MIME Types & Caching Optimizations
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddType application/javascript .js
  AddType text/css .css
</IfModule>
